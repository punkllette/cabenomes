---
import Icon from '../components/Icon.astro';
import BonusSection from '../components/BonusSection.astro';
import '../styles.css';
import '../genlabs-adapted.css';

const checkoutUrl = 'https://pay.kiwify.com.br/MxO0aeF';

const problems = [
  { number: '01', icon: 'calendar', title: 'A renda nunca é igual', text: 'Um mês entra mais, no outro entra menos.' },
  { number: '02', icon: 'wallet', title: 'As despesas não esperam', text: 'Contas e imprevistos aparecem quando o dinheiro está curto.' },
  { number: '03', icon: 'compass', title: 'Tudo parece complicado', text: 'Planilhas e apps cheios de funções dificultam a organização.' },
];
const features = [
  { icon: 'calendar', tag: 'Previsão', title: 'Veja até onde o dinheiro vai', text: 'Organize saldo, próxima entrada e contas futuras.' },
  { icon: 'target', tag: 'Simulação', title: 'Teste antes de decidir', text: 'Simule um gasto e entenda o impacto no seu saldo.' },
  { icon: 'spark', tag: 'Jornada', title: 'Perceba o seu avanço', text: 'Acompanhe dívidas, metas e pequenos passos.' },
];
const faqs = [
  ['Preciso ter renda fixa para usar o Cabe no Mês?', 'Não. O Cabe no Mês acompanha também quem recebe valores diferentes ao longo do mês.'],
  ['O aplicativo serve para quem está endividado?', 'Sim. Você pode registrar dívidas, acompanhar o quanto falta e visualizar seu progresso.'],
  ['Preciso entender de finanças?', 'Não. A proposta é facilitar as decisões do dia a dia com informações simples.'],
  ['Posso utilizar pelo celular?', 'O aplicativo foi criado para uma experiência prática também em telas menores.'],
  ['Como funciona o acesso?', 'Após a confirmação da compra, você receberá as orientações de acesso.'],
  ['O pagamento é único ou recorrente?', 'O acesso é por pagamento único de R$ 27,90.'],
  ['O que está incluso nos R$ 27,90?', 'O app Cabe no Mês, o e-book com 200 ideias de renda extra, podcasts, videoaulas, infográficos, acompanhamento de investimentos e experiência gamificada.'],
];
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="theme-color" content="#eef2f7" />
  <meta name="description" content="Cabe no Mês: veja quanto ainda pode gastar até a próxima entrada. App, e-book com 200 ideias de renda extra e conteúdos bônus por R$ 27,90." />
  <title>Cabe no Mês — App e bônus por R$ 27,90</title>
</head>
<body>
<header class="site-header"><div class="container header-inner"><a class="logo" href="#top" aria-label="Cabe no Mês, voltar ao início"><span class="logo-mark"><Icon name="arrowUp" size={18} /></span><span>cabe no <span class="logo-soft">mês</span></span></a><nav class="desktop-nav" aria-label="Navegação principal"><a href="#como-funciona">Como funciona</a><a href="#recursos">Recursos</a><a href="#bonus">Bônus</a><a href="#perguntas">Dúvidas</a></nav><a class="button header-cta" href={checkoutUrl}>Quero começar <Icon name="arrow" size={17} /></a></div></header>

<main id="top">
  <section class="hero"><div class="hero-orb orb-a"></div><div class="hero-orb orb-b"></div><div class="container hero-grid"><div class="hero-copy"><div class="eyebrow"><span class="eyebrow-pulse"></span> seu dinheiro pode ir mais longe</div><h1>Pare de adivinhar se o dinheiro vai dar <em>até a próxima entrada.</em></h1><p class="hero-lead">Veja quanto ainda pode gastar, antecipe os apertos e decida com clareza. Por R$ 27,90, leve o Cabe no Mês e todos os bônus.</p><div class="hero-actions"><a class="button" href={checkoutUrl}>Quero o app + bônus por R$ 27,90 <Icon name="arrow" size={17} /></a><a class="text-link" href="#recursos"><span class="play-circle"><Icon name="play" size={13} /></span> Veja como funciona</a></div><div class="microcopy"><Icon name="check" size={15} /> Pagamento único. App e bônus inclusos.</div></div><div class="phone-wrap" aria-label="Prévia ilustrativa do Cabe no Mês"><div class="phone-glow"></div><div class="phone"><div class="phone-notch"></div><div class="phone-screen"><div class="app-top"><span class="app-wordmark">cabe no mês</span><span class="app-chip">hoje</span></div><div class="app-hero"><span>Cabe no Mês</span><strong>R$ 720,00</strong><small><Icon name="calendar" size={12} /> até 30 de nov</small></div><div class="app-progress"><div><span class="mini-icon"><Icon name="spark" size={14} /></span><span><small>sua jornada</small><b>Você está avançando.</b></span></div><strong>0 XP</strong><div class="progress-line"><i></i></div></div><div class="phone-label"><span>ajuste rápido</span><b>Previsão</b></div><div class="forecast-card"><div><small>menor saldo</small><strong>R$ 370,00</strong></div><span class="forecast-badge">+R$ 4.570</span></div><div class="phone-label"><span>antes de comprar</span><b>Simular</b></div><div class="sim-card"><span class="sim-icon"><Icon name="target" size={15} /></span><span><small>e se eu gastar?</small><b>Teste sem medo.</b></span><strong>R$ 370,00</strong></div><div class="phone-nav"><span class="active"><Icon name="wallet" size={15} />Início</span><span><Icon name="calendar" size={15} />Previsão</span><span><Icon name="target" size={15} />Simular</span></div></div></div><div class="float-note note-one"><span class="note-dot green"></span><span><b>próxima entrada</b><small>em 16 dias</small></span></div><div class="float-note note-two"><span class="note-dot dark"></span><span><b>dia apertado</b><small>24 de nov</small></span></div></div></div><div class="container trust-row"><span>feito para quando o mês não vem igual</span><i></i><span>sem planilhas complicadas</span><i></i><span>com clareza até a próxima entrada</span></div></section>

  <section class="section problem-section"><div class="container"><div class="section-heading centered problem-heading"><span class="section-kicker">a vida real não cabe numa planilha</span><h2>O aperto não avisa. Sua previsão pode avisar.</h2><p>Saiba o que entra, o que sai e onde o saldo aperta.</p></div><div class="card-grid problem-grid">{problems.map((item) => <article class="problem-card"><div class="card-top"><span class="card-number">{item.number}</span><span class="icon-box"><Icon name={item.icon} size={21} /></span></div><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></div></section>

  <section class="section feature-section" id="recursos"><div class="container"><div class="section-heading centered"><span class="section-kicker">menos confusão, mais visão</span><h2>Veja o aperto antes de ele chegar.</h2><p>Previsão, simulação e jornada em um app que fala a sua língua.</p></div><div class="feature-layout"><div class="feature-list">{features.map((item, index) => <button type="button" class:list={['feature-card', index === 0 && 'selected']} data-feature={index} aria-pressed={index === 0}><span class="icon-box"><Icon name={item.icon} size={20} /></span><span><span class="feature-tag">{item.tag}</span><h3>{item.title}</h3><span class="feature-description">{item.text}</span></span><span class="feature-arrow"><Icon name="arrow" size={16} /></span></button>)}</div><div class="feature-visual" id="feature-visual"><div class="visual-header"><span id="visual-label">visão do seu ciclo · previsão</span><span class="visual-date">NOV / 2026 <Icon name="chevron" size={13} /></span></div><div id="visual-content"><div class="visual-balance"><span>saldo agora</span><strong>R$ 2.850<span>,00</span></strong><div class="balance-meta"><span><i class="legend-dot green-dot"></i> disponível</span><span><i class="legend-dot orange-dot"></i> próximo aperto</span></div></div><div class="timeline"><div class="timeline-item today"><span class="timeline-dot"></span><div><b>Hoje</b><small>R$ 2.850,00</small></div></div><div class="timeline-item"><span class="timeline-dot"></span><div><b>24 de nov</b><small>Fatura do cartão</small></div><strong>R$ 370,00</strong></div><div class="timeline-item next"><span class="timeline-dot"></span><div><b>30 de nov</b><small>Próxima entrada</small></div><strong>+R$ 4.570,00</strong></div></div><div class="visual-footer"><Icon name="eye" size={15} /> menor saldo previsto <b>R$ 370,00</b></div></div></div></div></div></section>

  <section class="section how-section" id="como-funciona" data-progress-section><div class="container"><div class="section-heading centered"><span class="section-kicker">um passo de cada vez</span><h2>Começar a se organizar pode ser mais simples do que parece.</h2></div><div class="steps"><div class="step-line"></div><div class="step-line-progress" style="--progress:0%"></div>{[['01','Comece pela sua realidade','Organize suas informações financeiras sem precisar ter renda fixa.'],['02','Acompanhe seu dinheiro','Use os recursos disponíveis para compreender suas movimentações.'],['03','Planeje com mais clareza','Tome decisões mais conscientes a partir do que você já sabe.']].map(([num,title,text], index) => <article class:list={['step', index === 0 && 'current']} data-step={index}><span class="step-num">{num}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>

  <section class="section audience-section"><div class="container audience-grid"><div><span class="section-kicker">feito para gente de verdade</span><h2>Feito para quem vive a vida real.</h2><p>O primeiro passo é conseguir enxergar o que acontece com o dinheiro que você tem hoje.</p><a class="button button-dark" href={checkoutUrl}>Conhecer o Cabe no Mês <Icon name="arrow" size={17} /></a></div><div class="audience-list">{['Autônomos e freelancers','Quem faz bicos ou recebe por trabalho','Pessoas com orçamento apertado','Estudantes começando a se organizar','Quem quer sair do improviso financeiro'].map((item, index) => <div class="audience-item"><span>{String(index + 1).padStart(2,'0')}</span><strong>{item}</strong><Icon name="check" size={17} /></div>)}</div></div></section>
  <BonusSection />
  <section class="section offer-section" id="oferta"><div class="container offer-wrap"><div class="offer-copy"><span class="section-kicker">tudo incluso por um pagamento único</span><h2>O app para organizar o mês. Os bônus para ir além.</h2><p>Leve o Cabe no Mês, o e-book com 200 ideias de renda extra, a biblioteca de conteúdos e os recursos extras por R$ 27,90.</p><div class="offer-points"><span><Icon name="check" size={15} /> app completo</span><span><Icon name="check" size={15} /> todos os bônus inclusos</span><span><Icon name="check" size={15} /> pagamento único</span></div></div><div class="price-card"><span class="price-label">app + todos os bônus</span><div class="price-comparison">de <del>R$ 97,00</del> por</div><div class="price"><small>R$</small>27<span>,90</span></div><p>pagamento único</p><a class="button" href={checkoutUrl}>Quero tudo por R$ 27,90 <Icon name="arrow" size={17} /></a><small class="secure-note"><Icon name="lock" size={13} /> checkout seguro</small></div></div></section>
  <section class="section faq-section" id="perguntas"><div class="container faq-grid"><div><span class="section-kicker">ainda ficou uma dúvida?</span><h2>Perguntas frequentes</h2><p>Respostas diretas para você decidir com tranquilidade.</p></div><div class="faq-list">{faqs.map(([question, answer], index) => <div class:list={['faq-item', index === 0 && 'open']}><button type="button" aria-expanded={index === 0}>{question}<span class="faq-toggle"><Icon name="plus" size={17} /></span></button><p>{answer}</p></div>)}</div></div></section>
</main>

<footer class="site-footer"><div class="container footer-top"><div><a class="logo" href="#top"><span class="logo-mark"><Icon name="arrowUp" size={18} /></span><span>cabe no <span class="logo-soft">mês</span></span></a><p>Seu dinheiro até a próxima entrada.</p></div><div class="footer-links"><div><span>navegue</span><a href="#recursos">Recursos</a><a href="#como-funciona">Como funciona</a><a href="#bonus">Bônus</a><a href="#perguntas">Perguntas frequentes</a></div><div><span>ajuda</span><a href="mailto:mello@auveloir.com">Entre em contato</a><a href={`${import.meta.env.BASE_URL}termos/`}>Termos de Uso</a><a href="#privacidade">Política de Privacidade</a></div></div></div><div class="container footer-bottom"><span>© 2026 Auveloir. Todos os direitos reservados.</span><span>Cabe no Mês · Brasil</span></div></footer>

<script>
  const featureContent = [
    document.querySelector('#visual-content').innerHTML,
    `<div class="simulation-preview"><div><span class="preview-label">e se eu gastar?</span><h3>Teste sem medo.</h3><p>Veja quanto ainda pode gastar sem comprometer o mês.</p><div class="sim-input"><span>gasto simulado</span><strong>R$ 350,00</strong></div></div><div class="sim-result"><span>depois do gasto</span><strong>R$ 370<span>,00</span></strong><small>livre até 30 de nov</small><div class="result-bar"><i></i></div></div></div>`,
    `<div class="journey-preview"><span class="preview-label">sistema gamificado</span><h3>Cada avanço conta.</h3><p>Organize sua vida financeira e acompanhe sua evolução por etapas.</p><div class="journey-stats"><span><b>Nível 1</b><small>jornada atual</small></span><span><b>0 / 500 XP</b><small>próximo nível</small></span></div><div class="journey-bar"><i></i></div><small>Seu progresso começa com um passo simples.</small></div>`
  ];
  const labels = ['previsão', 'simulação', 'jornada'];
  document.querySelectorAll('[data-feature]').forEach((card) => card.addEventListener('click', () => { const index = Number(card.dataset.feature); document.querySelectorAll('[data-feature]').forEach((item) => { item.classList.toggle('selected', item === card); item.setAttribute('aria-pressed', item === card); }); document.querySelector('#visual-label').textContent = `visão do seu ciclo · ${labels[index]}`; document.querySelector('#visual-content').innerHTML = featureContent[index]; }));
  document.querySelectorAll('.faq-item button').forEach((button) => button.addEventListener('click', () => { const item = button.closest('.faq-item'); const open = item.classList.toggle('open'); button.setAttribute('aria-expanded', open); }));
  const progressSection = document.querySelector('[data-progress-section]'); const progressLine = document.querySelector('.step-line-progress'); const steps = [...document.querySelectorAll('[data-step]')];
  const updateProgress = () => { if (!progressSection) return; const passed = Math.max(0, -progressSection.getBoundingClientRect().top + innerHeight * .34); const active = Math.min(2, Math.floor(passed / Math.max(140, innerHeight * .22))); progressLine.style.setProperty('--progress', `${active * 40}%`); steps.forEach((step, index) => step.classList.toggle('current', index <= active)); };
  addEventListener('scroll', updateProgress, { passive: true }); addEventListener('resize', updateProgress); updateProgress();
</script>
</body>
</html>
