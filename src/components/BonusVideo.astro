---
import Icon from './Icon.astro';
const videoId = '7BfaCtck6Z8';
const videoUrl = `https://youtu.be/${videoId}`;
---

<div class="bonus-video" data-bonus-video={videoId}>
  <div class="bonus-video-frame">
    <a class="bonus-video-cover" href={videoUrl} target="_blank" rel="noopener noreferrer" data-play-bonus aria-label="Reproduzir prévia dos conteúdos bônus do Cabe no Mês">
      <img src={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
      <span class="bonus-video-label">conteúdo bônus · prévia</span>
      <span class="bonus-video-play"><Icon name="play" size={23} /></span>
      <span class="bonus-video-caption">Um spoiler do que vem junto.</span>
    </a>
  </div>
  <a class="bonus-video-external" href={videoUrl} target="_blank" rel="noopener noreferrer">Assistir no YouTube <Icon name="arrow" size={14} /></a>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-bonus-video]').forEach((container) => {
    const trigger = container.querySelector<HTMLAnchorElement>('[data-play-bonus]');
    trigger?.addEventListener('click', (event) => {
      event.preventDefault();
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${container.dataset.bonusVideo}?autoplay=1&rel=0&playsinline=1`;
      frame.title = 'Prévia dos conteúdos bônus do Cabe no Mês';
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      frame.allowFullscreen = true;
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      container.querySelector('.bonus-video-frame')?.replaceChildren(frame);
      frame.focus();
    });
  });
</script>

<style>
  .bonus-video { width:100%; }
  .bonus-video-frame { position:relative; aspect-ratio:16/9; overflow:hidden; border-radius:20px; background:#14213d; box-shadow:0 18px 35px rgba(20,33,61,.18); }
  .bonus-video-cover { position:absolute; inset:0; display:flex; flex-direction:column; justify-content:space-between; padding:18px; color:white; isolation:isolate; }
  .bonus-video-cover img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:-2; transition:transform .25s ease; }
  .bonus-video-cover::before { content:''; position:absolute; inset:0; z-index:-1; background:linear-gradient(180deg,rgba(9,22,52,.7),rgba(9,22,52,.22) 45%,rgba(9,22,52,.85)); }
  .bonus-video-label { font-size:10px; font-weight:600; text-transform:uppercase; letter-spacing:.09em; }
  .bonus-video-play { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); display:grid; place-items:center; width:50px; height:50px; padding-left:3px; border-radius:50%; background:#eaf0ff; color:#2455d6; box-shadow:0 5px 20px #0003; }
  .bonus-video-caption { font-size:15px; font-weight:700; letter-spacing:-.03em; }
  .bonus-video-cover:hover img { transform:scale(1.035); }
  .bonus-video-cover:focus-visible { outline:3px solid #a9bcff; outline-offset:-4px; }
  .bonus-video-frame :global(iframe) { display:block; width:100%; height:100%; border:0; }
  .bonus-video-external { display:flex; align-items:center; justify-content:center; gap:7px; margin-top:14px; color:#254bad; font-size:12px; font-weight:600; }
  @media (prefers-reduced-motion:reduce) { .bonus-video-cover img { transition:none; } }
</style>
