---
import Icon from './Icon.astro';
import BonusVideo from './BonusVideo.astro';

const bonuses = [
  {
    number: '01',
    icon: 'light',
    tag: '20 possibilidades',
    title: 'E-book: 20 ideias de renda extra',
    text: 'Precisa fazer um dinheiro a mais? Explore opções que combinam com seu tempo, suas habilidades e o que você já tem à mão.',
  },
  {
    number: '02',
    icon: 'play',
    tag: 'aprenda no seu ritmo',
    title: 'Podcasts, videoaulas e infográficos',
    text: 'Ouça no caminho, assista quando puder ou consulte um infográfico para entender um assunto em poucos minutos.',
  },
  {
    number: '03',
    icon: 'compass',
    tag: 'acompanhe o que já investe',
    title: 'Acompanhamento de investimentos',
    text: 'Registre e acompanhe os investimentos que você já tem, junto com o seu orçamento. Sem compra ou venda de ativos pelo app.',
  },
  {
    number: '04',
    icon: 'spark',
    tag: 'mais leve, mais envolvente',
    title: 'Experiência gamificada',
    text: 'Acompanhe seus passos com elementos de jogo que tornam a rotina financeira mais envolvente.',
  },
];
---

<section class="section bonus-section" id="bonus" aria-labelledby="bonus-title">
  <div class="container">
    <div class="bonus-intro">
      <div>
        <span class="section-kicker">o app é só o começo</span>
        <h2 id="bonus-title">O app resolve o mês. <em>Os bônus vêm junto.</em></h2>
      </div>
      <p>Por R$ 27,90, leve o Cabe no Mês, um e-book com 20 ideias de renda extra, conteúdos financeiros e dois recursos extras no app.</p>
    </div>

    <div class="bonus-showcase">
      <div class="bonus-showcase-copy">
        <span class="bonus-spotlight-label"><span></span> prévia dos conteúdos extras</span>
        <h3>Dê o play. Isso é só uma amostra do que vem junto.</h3>
        <p>Conteúdo para aprender no seu ritmo, além das ferramentas para organizar o mês.</p>
      </div>
      <BonusVideo />
    </div>

    <div class="bonus-grid">
      {bonuses.map((bonus) => (
        <article class="bonus-card">
          <div class="bonus-card-top"><span>{bonus.number} / 04</span><span class="bonus-icon"><Icon name={bonus.icon} size={21} /></span></div>
          <span class="bonus-tag">{bonus.tag}</span>
          <h3>{bonus.title}</h3>
          <p>{bonus.text}</p>
        </article>
      ))}
    </div>

    <div class="bonus-close">
      <div><span>app + todos os bônus</span><h3>Um pacote que poderia custar R$&nbsp;97. <strong>Hoje, R$&nbsp;27,90 levam tudo.</strong></h3><p>Pagamento único. Sem precisar escolher entre o app e os conteúdos extras.</p></div>
      <a class="button" href="https://pay.kiwify.com.br/MxO0aeF">Quero tudo por R$&nbsp;27,90 <Icon name="arrow" size={17} /></a>
    </div>
  </div>
</section>

<style>
  .bonus-section { background:#edf2fc; }
  .bonus-intro { display:flex; flex-direction:column; align-items:center; gap:15px; margin-bottom:30px; text-align:center; }
  .bonus-intro h2 { max-width:820px; margin:13px auto 0; font-size:clamp(34px,4.2vw,55px); line-height:1.06; letter-spacing:-.065em; }
  .bonus-intro h2 em { color:#2455d6; font-style:normal; }
  .bonus-intro > p { max-width:650px; margin:0 auto 3px; color:#5f6e85; font-size:15px; line-height:1.65; }
  .bonus-showcase { display:grid; grid-template-columns:.82fr 1.18fr; gap:28px; align-items:center; padding:27px; border:1px solid rgba(255,255,255,.7); border-radius:26px; background:linear-gradient(135deg,#1a3164,#102244); box-shadow:0 20px 44px rgba(16,35,75,.14); }
  .bonus-showcase-copy { padding:0 12px; color:white; }
  .bonus-spotlight-label { display:inline-flex; align-items:center; gap:9px; color:#b7caff; font-size:10px; font-weight:700; letter-spacing:.13em; text-transform:uppercase; }
  .bonus-spotlight-label span { width:7px; height:7px; border-radius:50%; background:#86a6ff; box-shadow:0 0 0 4px rgba(134,166,255,.15); }
  .bonus-showcase h3 { max-width:370px; margin:16px 0 11px; font-size:clamp(24px,2.7vw,37px); line-height:1.1; letter-spacing:-.055em; }
  .bonus-showcase p { max-width:340px; margin:0; color:#c1d0ef; font-size:13px; line-height:1.55; }
  .bonus-showcase :global(.bonus-video-external) { color:#d3e0ff; }
  .bonus-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; margin-top:14px; }
  .bonus-card { min-width:0; padding:23px 21px 25px; border:1px solid #dce5f2; border-radius:20px; background:rgba(255,255,255,.87); box-shadow:0 9px 28px rgba(21,54,105,.045); }
  .bonus-card-top { display:flex; align-items:center; justify-content:space-between; margin-bottom:27px; color:#8799b4; font-size:10px; font-weight:700; }
  .bonus-icon { display:grid; place-items:center; width:39px; height:39px; border-radius:12px; background:#eaf0ff; color:#2455d6; }
  .bonus-tag { color:#2455d6; font-size:9px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  .bonus-card h3 { margin:8px 0 10px; font-size:19px; line-height:1.2; letter-spacing:-.045em; }
  .bonus-card p { margin:0; color:#66758d; font-size:12px; line-height:1.58; }
  .bonus-close { display:flex; justify-content:space-between; align-items:center; gap:30px; margin-top:15px; padding:29px 32px; border:1px solid #cedbf8; border-radius:23px; background:linear-gradient(115deg,#e0eaff,#f6f9ff); }
  .bonus-close span { color:#2455d6; font-size:10px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  .bonus-close h3 { max-width:650px; margin:8px 0 7px; font-size:clamp(22px,2.5vw,31px); line-height:1.14; letter-spacing:-.055em; }
  .bonus-close h3 strong { display:block; margin-top:4px; color:#2455d6; }
  .bonus-close p { margin:0; color:#66758d; font-size:12px; }
  .bonus-close .button { max-width:280px; flex:0 0 auto; text-align:center; }
  @media (max-width:950px) { .bonus-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } .bonus-close { align-items:flex-start; flex-direction:column; } .bonus-close .button { max-width:none; } }
  @media (max-width:700px) { .bonus-intro,.bonus-showcase { grid-template-columns:1fr; gap:24px; } .bonus-intro > p { max-width:none; } .bonus-showcase { padding:21px; } .bonus-showcase-copy { padding:3px 2px 0; } }
  @media (max-width:520px) { .bonus-intro { gap:16px; margin-bottom:23px; } .bonus-intro h2 { font-size:36px; } .bonus-intro > p { font-size:14px; } .bonus-grid { grid-template-columns:1fr; gap:10px; } .bonus-card { padding:18px; } .bonus-card-top { margin-bottom:12px; } .bonus-card h3 { font-size:18px; } .bonus-card p { font-size:13px; } .bonus-close { padding:23px; } .bonus-close .button { width:100%; } }
</style>
